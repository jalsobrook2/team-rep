# Local development environment (for running tests outside Docker)
PORT=3000
NODE_ENV=development

# MongoDB Configuration for local development (connecting to Docker MongoDB from host)
MONGODB_URI=mongodb://localhost:27017/backend-example
MONGODB_URI_TEST=mongodb://localhost:27017/backend-example-test

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-very-secure-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-very-secure-refresh-secret-key-change-in-production

# Client URL for CORS
CLIENT_URL=http://localhost:3000

# Docker environment flag
DOCKER=false