{
  "name": "backend-example",
  "version": "1.0.0",
  "description": "Backend example using Express.js and Mongoose",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:docker": "jest --config jest.docker.config.js --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "test:unit": "jest --testPathPattern=tests --forceExit --detectOpenHandles",
    "test:e2e": "start-server-and-test start http://localhost:3000 cypress:run",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "test:all": "npm run test:unit && npm run test:e2e",
    "lint": "echo 'Linting would run here'",
    "build:css": "tailwindcss -i ./Frontend/styles/styles.css -o ./Frontend/styles/output.css --watch"
  },
  "keywords": [
    "express",
    "mongoose",
    "mongodb",
    "api",
    "crud"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.66.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "autoprefixer": "^10.4.21",
    "cypress": "^15.6.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "mongodb-memory-server": "^10.3.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "start-server-and-test": "^2.1.2",
    "supertest": "^6.3.3",
    "tailwindcss": "^4.1.17"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrOwen101/Backend-Example.git"
  },
  "bugs": {
    "url": "https://github.com/DrOwen101/Backend-Example/issues"
  },
  "homepage": "https://github.com/DrOwen101/Backend-Example#readme"
}
