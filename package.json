{
  "name": "team-rep",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:server": "nodemon server.js",
    "client": "vite --host",
    "dev": "concurrently \"npm run dev:server\" \"npm run client\"",
    "dev:client": "vite --host",
    "client:build": "vite build",
    "client:preview": "vite preview",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run client\"",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "test:components": "jest --config jest.component.config.js --forceExit",
    "test:components:coverage": "jest --config jest.component.config.js --coverage --forceExit",
    "test:unit": "npm run test && npm run test:components",
    "smoke": "node scripts/smoke-test.js",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "cypress:headless": "cypress run --headless",
    "cypress:mobile": "cypress run --config viewportWidth=375,viewportHeight=667",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "test:e2e:prep": "npm run client:build",
    "test:e2e:server": "npm run start:prod",
    "test:e2e": "npm run test:e2e:prep && node scripts/run-e2e-tests.js",
    "test:all": "npm run lint && npm run test:coverage && npm run test:e2e",
    "test:sentry": "curl http://localhost:3000/api/test-error-2"
  },
  "keywords": [
    "express",
    "mongoose",
    "mongodb",
    "api",
    "crud"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.27.0",
    "@sentry/react": "^10.27.0",
    "axios": "^1.5.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uuid": "^13.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.0.0",
    "babel-jest": "^30.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "cypress": "^13.6.2",
    "eslint": "^8.57.0",
    "eslint-plugin-cypress": "^2.15.2",
    "eslint-plugin-react": "^7.33.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^16.0.0",
    "jsdom": "^27.2.0",
    "mongodb-memory-server": "^8.12.0",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "start-server-and-test": "^2.0.3",
    "supertest": "^6.3.3",
    "vite": "^5.0.0",
    "wait-on": "^9.0.3"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrOwen101/Backend-Example.git"
  },
  "bugs": {
    "url": "https://github.com/DrOwen101/Backend-Example/issues"
  },
  "homepage": "https://github.com/DrOwen101/Backend-Example#readme"
}
