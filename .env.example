# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
# For local development with Docker: mongodb://mongo:27017/backend-example
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/backend-example

# For test environment
MONGODB_URI_TEST=mongodb://mongo:27017/backend-example-test

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-very-secure-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-very-secure-refresh-secret-key-change-in-production

# Client URL for CORS
CLIENT_URL=http://localhost:3000

# Docker environment flag (set to 'true' when running in Docker)
DOCKER=false

# Sentry configuration (optional)
# Backend Sentry DSN - leave blank locally unless you have a DSN
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Frontend Sentry (Vite) - client-side DSN must be prefixed with VITE_
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
